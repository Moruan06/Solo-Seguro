# URL do backend Solo Seguro (dashboard). Em dev local:
VITE_API_URL=http://localhost:8080

# IDs dos sensores demo (seed V4) — usados para carregar o histórico
# imediatamente ao abrir. Em produção/multi-tenant o app também descobre
# os IDs automaticamente pelas leituras que chegam via SSE.
VITE_SENSOR_TEMP=40000000-0000-0000-0000-000000000002
VITE_SENSOR_UMID=40000000-0000-0000-0000-000000000001
VITE_SENSOR_GAS=40000000-0000-0000-0000-000000000004
